# Sarvam AI
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Server-to-server access from MediLoop (required outside local development)
SCREENING_API_KEY=

# IMPORTANT (Cloudflare Workers / managed runtime):
# Shared SCREENING_API_KEY is REJECTED by default in production.
# Either set this to true during migration:
#   SCREENING_ALLOW_SHARED_API_KEY=true
# Or prefer per-clinic keys (same JSON on MediLoop as CLINICAL_SCREENING_API_KEYS_JSON):
#   SCREENING_CLINIC_API_KEYS_JSON={"clinic-demo-001":"your-clinic-key"}
# SCREENING_ALLOW_SHARED_API_KEY=
# SCREENING_CLINIC_API_KEYS_JSON=

# Public base URL used to create patient screening links (HTTPS in prod)
PATIENT_APP_URL=https://ai-clinical-screening.tulasianand6.workers.dev

# Cloudflare D1 is the only production persistence backend.
# Local development uses Wrangler's local D1 database binding (DB).
PORT=3000
MAX_QUESTIONS=12
MIN_QUESTIONS=3
PATIENT_TOKEN_TTL_HOURS=72

WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v21.0
WA_WEBHOOK_VERIFY_TOKEN=
WA_APP_SECRET=
WA_COMPLAINT_TEMPLATE_NAME=mediloop_add_complaints
WA_COMPLAINT_TEMPLATE_LANGUAGE=en
