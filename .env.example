# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Meta WhatsApp Cloud API - reuse the values already used by MediLoop
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v21.0
WA_WEBHOOK_VERIFY_TOKEN=
WA_APP_SECRET=

# Initial proactive message. If set, this approved Meta template is used.
WA_INITIAL_TEMPLATE_NAME=
WA_INITIAL_TEMPLATE_LANGUAGE=en

# If this service becomes the Meta webhook endpoint for the shared Meta app,
# forward non-screening messages back to the existing MediLoop webhook.
MEDILOOP_WEBHOOK_FORWARD_URL=

PORT=3000
BASE_URL=http://localhost:3000
MAX_QUESTIONS=12
SESSION_TTL_HOURS=48
