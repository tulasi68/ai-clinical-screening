t_kn":"ದಯವಿಟ್ಟು ನಿಮ್ಮ ಮುಖ್ಯ ಸಮಸ್ಯೆಯನ್ನು ಕೆಲವು ಪದಗಳಲ್ಲಿ ವಿವರಿಸಿ."}],"level3":[]}},"shared_tail":[{"id":"red_flag_symptoms","type":"multi","text":"Are you experiencing any of these severe symptoms right now?","text_kn":"ಈ ಕಠಿಣ ಲಕ್ಷಣಗಳಲ್ಲಿ ಯಾವುದಾದರೂ ಈಗ ಇದೆಯೇ?","options":[{"id":"dyspnea","label":"Shortness of breath","label_kn":"ಉಸಿರಾಟದ ತೊಂದರೆ"},{"id":"chest_pain","label":"Chest pain or pressure","label_kn":"ಎದೆ ನೋವು ಅಥವಾ ಒತ್ತಡ"},{"id":"fainting","label":"Fainting or severe dizziness","label_kn":"ಮೂರ್ಛೆ ಅಥವಾ ತೀವ್ರ ತಲೆಸುತ್ತು"},{"id":"none","label":"None of these","label_kn":"ಇವುಗಳಲ್ಲಿ ಯಾವುದೂ ಇಲ್ಲ","exclusive":true}]},{"id":"chronic_conditions","type":"multi","text":"Do you have any of these ongoing conditions?","text_kn":"ಈ ನಿರಂತರ ಪರಿಸ್ಥಿತಿಗಳಲ್ಲಿ ಯಾವುದಾದರೂ ಇದೆಯೇ?","options":[{"id":"hypertension","label":"High blood pressure","label_kn":"ಹೆಚ್ಚು ರಕ್ತದೊತ್ತಡ"},{"id":"diabetes","label":"Diabetes","label_kn":"ಮಧುಮೇಹ"},{"id":"asthma","label":"Asthma / lung disease","label_kn":"ಆಸ್ತಮಾ / ಶ್ವಾಸಕೋಶ ರೋಗ"},{"id":"none","label":"None","label_kn":"ಯಾವುದೂ ಇಲ್ಲ","exclusive":true}]},{"id":"active_medications","type":"text","text":"What medicines are you currently taking? (or type None)","text_kn":"ನೀವು ಈಗ ಯಾವ ಔಷಧಗಳನ್ನು ತೆಗೆದುಕೊಳ್ಳುತ್ತಿದ್ದೀರಿ? (ಇಲ್ಲವಾದರೆ None ಎಂದು ಬರೆಯಿರಿ)"},{"id":"drug_allergies_exist","type":"single","text":"Any medicine allergies?","text_kn":"ಯಾವುದಾದರೂ ಔಷಧ ಅಲರ್ಜಿ ಇದೆಯೇ?","options":[{"id":"no","label":"No","label_kn":"ಇಲ್ಲ"},{"id":"yes","label":"Yes","label_kn":"ಹೌದು"}]}]}
